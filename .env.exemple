# ################
# App/PWA
# ################

# [deprecated]
# The email to display to clients for support
SUPPORT_EMAIL=

# ################
# App/API
# ################

APP_SECRET=
BASE_URL="http://localhost"
TRUSTED_HOSTS=^(localhost|php|192\.168\.1\.[0-9]{1,3})$
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}&charset=utf8"

# ################
# Telemetry
# ################

# Posthog config for logging
POSTHOG_KEY=
POSTHOG_HOST=

# ################
# Local dev
# ################

# XDebug mode config
XDEBUG_MODE=develop,debug

# Allow quick admin login to the app
# /!\ WARNING: this should only be set in local!
DEV_LOGIN_KEY=

# ################
# docker
# ################

# Caddy servername
SERVER_NAME=:80

# Database config
POSTGRES_VERSION=18
POSTGRES_DB=teatea
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

