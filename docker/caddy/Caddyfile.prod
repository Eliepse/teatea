{
	{$CADDY_GLOBAL_OPTIONS}

	servers {
		trusted_proxies static private_ranges
	}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root /app/pwa
	encode zstd br gzip

	# Add links to the API docs and to the Mercure Hub if not set explicitly (e.g. the PWA)
#	header ?Link `</docs.jsonld>; rel="http://www.w3.org/ns/hydra/core#apiDocumentation", </.well-known/mercure>; rel="mercure"`
	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"

	# Prevent exposing server engine
	header -Server
	header -Via

	# Keep media in cache for 60 days
	header /media* ?Cache-Control max-age=5184000
	header /runtime-env.js* Cache-Control no-cache
	header /sw.js Cache-Control no-cache

	# Short link for members pages
	@shortFriend {
		path /m/*
		path_regexp /m/(.*)
	}
	redir @shortFriend /members/{re.1}

	# Todo(elie): Prefix all api into "/api" subroute to simplify router matching
	@api expression `path(
		'/api*', '/auth*', '/docs*', '/bundles*', '/contexts*', '/_profiler*', '/_wdt*',
		'*.json*', '*.html', '*.csv', '*.yml', '*.yaml', '*.xml', '/media/*', '/client/pwa-support.js'
	) && !path('/manifest.json')`

	handle @api {
		php_server {
			root /app/public
			file_server off
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}
