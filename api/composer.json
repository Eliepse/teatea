{
	"type": "project",
	"license": "MIT",
	"require": {
		"php": "^8.5",
		"ext-ctype": "*",
		"ext-exif": "*",
		"ext-iconv": "*",
		"api-platform/doctrine-orm": "^4.2.0",
		"api-platform/symfony": "^4.2.0",
		"doctrine/doctrine-bundle": "^3.2",
		"doctrine/doctrine-migrations-bundle": "^4.0",
		"doctrine/orm": "^3.6",
		"lexik/jwt-authentication-bundle": "^3.2",
		"martin-georgiev/postgresql-for-doctrine": "^v4.0",
		"nelmio/cors-bundle": "^2.6",
		"phpstan/phpdoc-parser": "^2.3",
		"stof/doctrine-extensions-bundle": "^1.15",
		"symfony/asset": "^8.0.0",
		"symfony/brevo-mailer": "^8.0.0",
		"symfony/console": "^8.0.0",
		"symfony/dotenv": "^8.0.0",
		"symfony/expression-language": "^8.0.0",
		"symfony/flex": "^2.10",
		"symfony/framework-bundle": "^8.0.0",
		"symfony/mailer": "^8.0.0",
		"symfony/mercure-bundle": "^0.4",
		"symfony/messenger": "^8.0.0",
		"symfony/monolog-bundle": "^v4.0",
		"symfony/process": "^8.0.0",
		"symfony/property-access": "^8.0.0",
		"symfony/property-info": "^8.0.0",
		"symfony/runtime": "^8.0.0",
		"symfony/security-bundle": "^8.0.0",
		"symfony/serializer": "^8.0.0",
		"symfony/string": "^8.0.0",
		"symfony/twig-bundle": "^8.0.0",
		"symfony/validator": "^8.0.0",
		"symfony/yaml": "^8.0.0",
		"vich/uploader-bundle": "^2.9"
	},
	"require-dev": {
		"api-platform/schema-generator": "^5.2",
		"carthage-software/mago": "^1.2.2",
		"martinkup/symfony-profiler-optimization-advisor-bundle": "^0.1.0",
		"symfony/browser-kit": "^8.0.0",
		"symfony/css-selector": "^8.0.0",
		"symfony/debug-bundle": "^8.0.0",
		"symfony/maker-bundle": "^1.44",
		"symfony/phpunit-bridge": "^8.0.0",
		"symfony/stopwatch": "^8.0.0",
		"symfony/var-dumper": "^8.0.0",
		"symfony/web-profiler-bundle": "^8.0.0"
	},
	"config": {
		"optimize-autoloader": true,
		"preferred-install": {
			"*": "dist"
		},
		"sort-packages": true,
		"allow-plugins": {
			"carthage-software/mago": true,
			"symfony/flex": true,
			"symfony/runtime": true
		}
	},
	"autoload": {
		"psr-4": {
			"App\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\Tests\\": "tests/"
		}
	},
	"replace": {
		"paragonie/sodium_compat": "*",
		"paragonie/random_compat": "2.*",
		"symfony/polyfill-ctype": "*",
		"symfony/polyfill-iconv": "*",
		"symfony/polyfill-intl-grapheme": "*",
		"symfony/polyfill-intl-normalizer": "*",
		"symfony/polyfill-mbstring": "*",
		"symfony/polyfill-php84": "*",
		"symfony/polyfill-php83": "*",
		"symfony/polyfill-php82": "*",
		"symfony/polyfill-php81": "*",
		"symfony/polyfill-php80": "*",
		"symfony/polyfill-php73": "*",
		"symfony/polyfill-php72": "*",
		"symfony/polyfill-php71": "*",
		"symfony/polyfill-php70": "*"
	},
	"scripts": {
		"auto-scripts": {
			"cache:clear": "symfony-cmd",
			"assets:install %PUBLIC_DIR%": "symfony-cmd"
		},
		"post-install-cmd": [
			"@auto-scripts"
		],
		"post-update-cmd": [
			"@auto-scripts"
		],
		"analyze": "mago analyze --sort"
	},
	"conflict": {
		"symfony/symfony": "*"
	},
	"extra": {
		"symfony": {
			"allow-contrib": false,
			"require": "^8.0.0",
			"docker": false
		}
	}
}
